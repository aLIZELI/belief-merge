{
  "name": "dsh-belief-merge",
  "version": "0.2.0",
  "description": "Provenance-retaining cross-session context merge for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./core": "./lib/core/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "bench/**/*.js",
    "bench/README.md",
    "cordis.patch.yml",
    "TECHNICAL-REPORT.md",
    "VERIFY.md"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node demo.js",
    "bench": "node bench/run.js",
    "bench:tight": "node bench/run.js --seeds=5 --topics=10 --budget=400",
    "prepublishOnly": "node --test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "context",
    "merge",
    "belief-revision",
    "provenance",
    "submodular",
    "benchmark"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "author": "aLIZELI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aLIZELI/belief-merge.git",
    "directory": "belief-merge"
  },
  "homepage": "https://github.com/aLIZELI/belief-merge#readme",
  "bugs": {
    "url": "https://github.com/aLIZELI/belief-merge/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2"
  }
}
